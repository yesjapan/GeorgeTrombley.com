# Cloudflare Pages headers.
#
# Rules are evaluated top to bottom and a later matching rule overrides an
# earlier one for the same header. So the broad default comes first and the
# fingerprinted-asset rule overrides it.
#
# Note these match the REQUEST path, not the file on disk: Astro emits
# dist/about/index.html but it is served at /about, so a rule like `/*.html`
# would almost never match. Don't reintroduce one.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # HTML is rewritten on every deploy, and /videos changes on a cron, so the
  # browser must revalidate. Cloudflare purges its own edge cache per deploy.
  Cache-Control: public, max-age=0, must-revalidate

# Astro fingerprints every filename under /_astro/ — CSS, JS and the optimised
# images — so the bytes at a given URL can never change. Cache them forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/og.jpg
  Cache-Control: public, max-age=604800

/rss.xml
  Cache-Control: public, max-age=1800
