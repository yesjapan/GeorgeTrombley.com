---
/**
 * A paginated reader: one page at a time, like an e-reader, sized to the
 * book's 6x9 trim.
 *
 * The content is passed in as slots and stays ordinary DOM — nothing is
 * pre-split into fixed pages. The prose is flowed into CSS columns inside a
 * fixed-height box, one column per page, and turning is a horizontal
 * translate. That is why it survives a resize, a rotation or a reader zooming.
 *
 * Slots:
 *   cover   — the cover art. Shown as page 0, edge to edge, no running head.
 *   front   — front matter: title page, copyright, dedication, prefatory text.
 *             Fixed pages in here use .reader__fixed and fill exactly one page;
 *             prose flows normally. Nothing before the chapter carries a folio.
 *   default — the chapter. Its root element carries data-chapter-start, which
 *             is where page numbering begins.
 *
 *  - The full text is in the HTML: searchable and read by a screen reader as
 *    continuous prose whichever page is showing.
 *  - With JavaScript off the reader never initialises and the same markup is a
 *    normal scrolling article. That is the default state, not a fallback.
 *  - A "Scroll" toggle returns to scrolling text at any time. The choice, and
 *    the sound setting, are remembered.
 */

interface Props {
  /** Accessible name for the region, e.g. "Chapter One". */
  label: string;
  /** Running head, e.g. the book title. */
  title: string;
}

const { label, title } = Astro.props;
const hasCover = Astro.slots.has('cover');
---

<div class="reader" data-reader data-has-cover={hasCover ? '' : undefined}>
  <div class="reader__bar">
    <div class="reader__modes" role="group" aria-label="Reading mode">
      <button class="reader__mode" type="button" data-mode="book" aria-pressed="true">
        Pages
      </button>
      <button class="reader__mode" type="button" data-mode="flow" aria-pressed="false">
        Scroll
      </button>
    </div>

    <button
      class="reader__sound"
      type="button"
      data-sound-toggle
      aria-pressed="true"
      title="Page-turn sound"
    >
      <span class="reader__sound-on" aria-hidden="true">🔊</span>
      <span class="reader__sound-off" aria-hidden="true">🔇</span>
      <span class="visually-hidden">Page-turn sound</span>
    </button>
  </div>

  <div class="reader__stage">
    <button class="reader__nav" type="button" data-prev aria-label="Previous page">
      <span aria-hidden="true">‹</span>
    </button>

    <div
      class="reader__page"
      data-book
      role="region"
      aria-label={`${label}, paginated reader`}
      tabindex="0"
    >
      {
        hasCover && (
          <div class="reader__cover" data-cover>
            <slot name="cover" />
          </div>
        )
      }

      <!-- Running head and corner marks, as on the printed page. Decorative;
           the page counter below carries the folio for assistive tech. -->
      <div class="reader__marks" aria-hidden="true">
        <p class="reader__runhead">
          <span>{title}</span>
          <span class="reader__runhead-sep">-</span>
          <span data-folio></span>
        </p>
        <span class="reader__corner reader__corner--tl"></span>
        <span class="reader__corner reader__corner--tr"></span>
        <span class="reader__corner reader__corner--bl"></span>
        <span class="reader__corner reader__corner--br"></span>
      </div>

      <div class="reader__viewport" data-viewport>
        <div class="reader__flow" data-flow>
          <slot name="front" />
          <slot />
        </div>
      </div>
    </div>

    <button class="reader__nav" type="button" data-next aria-label="Next page">
      <span aria-hidden="true">›</span>
    </button>
  </div>

  <div class="reader__foot">
    <p class="reader__pages" data-pages aria-live="polite"></p>
    <p class="reader__hint">Arrow keys, or swipe</p>
  </div>
</div>

<style>
  /* Everything that makes this a reader is scoped under .is-ready / .is-book.
     Before the script runs — or without it — the content is a plain article. */
  .reader__bar,
  .reader__nav,
  .reader__foot,
  .reader__marks {
    display: none;
  }

  .reader.is-ready .reader__bar,
  .reader.is-ready .reader__foot {
    display: flex;
  }

  .reader.is-ready.is-book .reader__nav {
    display: grid;
  }

  .reader.is-ready.is-book .reader__marks {
    display: block;
  }

  /* ---------- Toolbar ---------- */
  .reader__bar {
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-block-end: var(--space-md);
  }

  .reader__modes {
    display: inline-flex;
    border: 1px solid var(--rule);
    border-radius: 999px;
    overflow: hidden;
  }

  .reader__mode {
    padding: 0.4em 0.95em;
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    background: transparent;
    transition: background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .reader__mode[aria-pressed='true'] {
    background: var(--seal);
    color: var(--on-seal);
  }

  .reader__sound {
    padding: 0.3em 0.5em;
    font-size: var(--text-sm);
    line-height: 1;
    border: 1px solid var(--rule);
    border-radius: 999px;
    filter: grayscale(1);
    opacity: 0.7;
  }

  .reader__sound:hover {
    opacity: 1;
    border-color: var(--ink);
  }

  .reader__sound .reader__sound-off,
  .reader__sound[aria-pressed='false'] .reader__sound-on {
    display: none;
  }

  .reader__sound[aria-pressed='false'] .reader__sound-off {
    display: inline;
  }

  /* ---------- Stage ---------- */
  .reader__stage {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
  }

  .reader__nav {
    flex: none;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    font-size: var(--text-2xl);
    line-height: 1;
    color: var(--ink-muted);
    border: 1px solid var(--rule);
    border-radius: 50%;
    transition: color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      opacity var(--dur-fast) var(--ease-out);
  }

  .reader__nav:hover:not(:disabled) {
    color: var(--seal);
    border-color: var(--seal);
  }

  .reader__nav:disabled {
    opacity: 0.25;
    cursor: default;
  }

  /* ---------- The page ----------
     A 6x9 trim, the book's actual size. Every measurement on it is a fraction
     of its width (cqw) so the proportions hold at any size:

       6" page width            = 100cqw
       top margin      0.88"    = 14.67cqw
       bottom margin   0.40"    =  6.67cqw
       side margins    0.75"    = 12.5cqw  (inside 1" and outside 0.5",
                                            averaged — a single page has no
                                            inside or outside)
       text block      4.5"     = 75cqw wide

     The script sets the page's pixel width; the container query does the rest. */
  .reader__page {
    position: relative;
    flex: none;
    inline-size: 100%;
    max-inline-size: 42rem;
    container-type: inline-size;
  }

  .reader__page:focus-visible {
    outline: 2px solid var(--seal);
    outline-offset: 6px;
  }

  .reader {
    --page-top: 14.67cqw;
    --page-bottom: 6.67cqw;
    --page-side: 12.5cqw;
  }

  .reader.is-book .reader__viewport {
    overflow: hidden;
    aspect-ratio: 2 / 3;
    box-sizing: border-box;
    padding: var(--page-top) var(--page-side) var(--page-bottom);
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 2px;
    /* A page on a desk: a soft drop shadow, heavier at the bottom edge. */
    box-shadow:
      0 1px 2px rgba(25, 21, 18, 0.08),
      0 12px 32px -12px rgba(25, 21, 18, 0.28),
      0 32px 56px -28px rgba(25, 21, 18, 0.35);
  }

  .reader.is-book .reader__flow {
    column-fill: auto;
    transition: transform var(--dur-slow) var(--ease-in-out);
    will-change: transform;
  }

  /* ---------- The cover ----------
     Page 0. Laid over the whole page — no margins, no running head — because a
     cover bleeds to the trim. The flow's pages start at 1. */
  .reader.is-book .reader__cover {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    border-radius: 2px;
    box-shadow:
      0 1px 2px rgba(25, 21, 18, 0.08),
      0 12px 32px -12px rgba(25, 21, 18, 0.28),
      0 32px 56px -28px rgba(25, 21, 18, 0.35);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-slow) var(--ease-in-out);
  }

  .reader.is-book.is-cover .reader__cover {
    opacity: 1;
  }

  .reader.is-book .reader__cover :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* In scroll mode the cover is just the first thing on the page. */
  .reader:not(.is-book) .reader__cover {
    max-inline-size: 22rem;
    margin: 0 auto var(--space-xl);
  }

  .reader:not(.is-book) .reader__cover :global(img) {
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lift);
  }

  /* ---------- Fixed front-matter pages ----------
     Each fills exactly one column. A fresh column is forced before it, and
     whatever follows is forced onto the next one, so a title page is never
     shared with the copyright notice. */
  .reader.is-book :global(.reader__fixed) {
    break-before: column;
    break-inside: avoid;
    box-sizing: border-box;
    /* A percentage block-size does not resolve inside a multi-column box, so
       the script publishes the measured page height as --page-h. */
    block-size: var(--page-h, 100%);
    overflow: hidden;
  }

  /* The chapter always begins on a fresh page, as in the book. This also
     preserves the opener's top margin: a block that lands at the top of a
     column by an unforced break has that margin truncated; a forced break
     keeps it. */
  .reader.is-book :global(.reader__fixed + *),
  .reader.is-book :global(.reader__break),
  .reader.is-book :global([data-chapter-start]) {
    break-before: column;
  }

  .reader:not(.is-book) :global(.reader__fixed) {
    min-block-size: 50vh;
    display: flex;
    margin-block-end: var(--space-2xl);
  }

  /* ---------- Running head and corner marks ----------
     The running head sits in the 0.88" top margin, and the four brackets mark
     the corners of the 4.5" x 7.72" text block, as on the printed page. Front
     matter carries no folio, so the running head hides until the chapter. */
  .reader__marks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .reader.is-cover .reader__marks {
    display: none;
  }

  .reader__runhead {
    position: absolute;
    inset-block-start: 6.2cqw;
    inset-inline-end: var(--page-side);
    display: flex;
    gap: 0.9em;
    font-family: var(--reader-head-font, var(--font-body));
    font-size: 2.1cqw;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .reader.is-front .reader__runhead {
    visibility: hidden;
  }

  .reader__runhead-sep {
    opacity: 0.55;
  }

  .reader__corner {
    position: absolute;
    inline-size: 3.2cqw;
    block-size: 3.2cqw;
    border: 0 solid var(--rule-strong);
    opacity: 0.45;
  }

  .reader__corner--tl {
    inset-block-start: var(--page-top);
    inset-inline-start: var(--page-side);
    border-width: 1px 0 0 1px;
  }

  .reader__corner--tr {
    inset-block-start: var(--page-top);
    inset-inline-end: var(--page-side);
    border-width: 1px 1px 0 0;
  }

  .reader__corner--bl {
    inset-block-end: var(--page-bottom);
    inset-inline-start: var(--page-side);
    border-width: 0 0 1px 1px;
  }

  .reader__corner--br {
    inset-block-end: var(--page-bottom);
    inset-inline-end: var(--page-side);
    border-width: 0 1px 1px 0;
  }

  /* The turn: a brief dip in brightness reads as paper moving. Decorative. */
  .reader.is-turning .reader__flow {
    filter: brightness(0.985);
  }

  @media (prefers-reduced-motion: reduce) {
    .reader.is-book .reader__flow,
    .reader.is-book .reader__cover {
      transition: none;
    }
    .reader.is-turning .reader__flow {
      filter: none;
    }
  }

  /* ---------- Footer ---------- */
  .reader__foot {
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    max-inline-size: 42rem;
    margin: var(--space-sm) auto 0;
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .reader__pages {
    font-feature-settings: 'tnum' 1;
    letter-spacing: 0.06em;
  }

  .reader__hint {
    letter-spacing: 0.04em;
  }

  .reader:not(.is-book) .reader__hint {
    visibility: hidden;
  }

  @media (max-width: 40rem) {
    /* The arrows would steal width the page needs; tap, swipe and keys still work. */
    .reader.is-ready.is-book .reader__nav {
      display: none;
    }
  }
</style>

<script>
  const SOUND_KEY = 'gt:reader:sound';
  const MODE_KEY = 'gt:reader:mode';

  /** localStorage throws in some privacy modes; never let that break reading. */
  function readStore(key: string): string | null {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  }
  function writeStore(key: string, value: string) {
    try {
      localStorage.setItem(key, value);
    } catch {
      /* ignore */
    }
  }

  /**
   * The page turn is the same recording the Kanji From Zero! flip-book uses
   * (/audio/page-turn.mp3, under a second), so the two readers sound alike.
   * A single <audio> element rewound before each play, exactly as that viewer
   * does it. Browsers can refuse playback before the first user gesture; the
   * rejection is swallowed, since a silent turn is not an error.
   */
  class PageSound {
    private el: HTMLAudioElement | null = null;
    enabled = true;

    constructor(private readonly src: string) {}

    private ensure(): HTMLAudioElement {
      if (!this.el) {
        this.el = new Audio(this.src);
        this.el.preload = 'auto';
      }
      return this.el;
    }

    /** Fetch the clip ahead of the first turn so it plays without a stall. */
    prime() {
      this.ensure();
    }

    play() {
      if (!this.enabled) return;
      const el = this.ensure();
      el.currentTime = 0;
      void el.play().catch(() => {});
    }
  }

  function initReader(root: HTMLElement) {
    const viewportEl = root.querySelector<HTMLElement>('[data-viewport]');
    const flowEl = root.querySelector<HTMLElement>('[data-flow]');
    const pageEl = root.querySelector<HTMLElement>('[data-book]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]');
    const pagesOut = root.querySelector<HTMLElement>('[data-pages]');
    const folio = root.querySelector<HTMLElement>('[data-folio]');
    const soundBtn = root.querySelector<HTMLButtonElement>('[data-sound-toggle]');
    const modeBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-mode]')];
    if (!viewportEl || !flowEl || !pageEl) return;
    // Re-bound after the guard so the closures below see them as non-null.
    const viewport: HTMLElement = viewportEl;
    const flow: HTMLElement = flowEl;
    const page: HTMLElement = pageEl;

    // The cover, if there is one, is page 0 and lives outside the flow.
    const coverPages = root.hasAttribute('data-has-cover') ? 1 : 0;

    const sound = new PageSound('/audio/page-turn.mp3');
    sound.prime();
    sound.enabled = readStore(SOUND_KEY) !== 'off';
    soundBtn?.setAttribute('aria-pressed', String(sound.enabled));

    // `step` is one column plus the gap; `chapterStart` is the first page that
    // carries a folio.
    const state = { page: 0, pages: 1, step: 0, chapterStart: coverPages };

    function setMode(mode: 'book' | 'flow') {
      root.classList.toggle('is-book', mode === 'book');
      for (const b of modeBtns) {
        b.setAttribute('aria-pressed', String(b.dataset.mode === mode));
      }
      writeStore(MODE_KEY, mode);
      if (mode === 'book') {
        paginate();
      } else {
        flow.style.removeProperty('height');
        flow.style.removeProperty('--page-h');
        flow.style.removeProperty('column-width');
        flow.style.removeProperty('column-gap');
        flow.style.transform = '';
        page.style.removeProperty('inline-size');
        root.classList.remove('is-cover', 'is-front');
        if (pagesOut) pagesOut.textContent = '';
      }
    }

    /** Measure the box and let the browser flow the text into pages. */
    function paginate() {
      if (!root.classList.contains('is-book')) return;

      // Fit a 6x9 page to the space. Height is the constraint on a landscape
      // screen: the page has to fit once scrolled to, or the reader would be
      // scrolling AND turning. Budget the sticky site header, this toolbar and
      // the page counter out of it, then derive the width from the 2:3 ratio.
      const chrome =
        (document.querySelector<HTMLElement>('.site-header')?.getBoundingClientRect()
          .height ?? 0) +
        (root.querySelector<HTMLElement>('.reader__bar')?.offsetHeight ?? 0) +
        (root.querySelector<HTMLElement>('.reader__foot')?.offsetHeight ?? 0) +
        56;
      const availH = Math.max(480, window.innerHeight - chrome);

      const navVisible = prevBtn && getComputedStyle(prevBtn).display !== 'none';
      const navSpace = navVisible ? prevBtn!.offsetWidth * 2 + 40 : 0;
      const availW = root.clientWidth - navSpace;

      const pageW = Math.floor(Math.min((availH * 2) / 3, availW, 672));
      const pageH = Math.round(pageW * 1.5);
      page.style.inlineSize = `${pageW}px`;

      // Padding is in cqw, so it resolves only now that the width is set.
      const styles = getComputedStyle(viewport!);
      const padX = parseFloat(styles.paddingLeft) + parseFloat(styles.paddingRight);
      const padY = parseFloat(styles.paddingTop) + parseFloat(styles.paddingBottom);
      const border =
        parseFloat(styles.borderTopWidth) + parseFloat(styles.borderBottomWidth);
      const width = viewport.clientWidth - padX;
      const height = pageH - padY - border;

      flow.style.height = `${height}px`;
      flow.style.setProperty('--page-h', `${height}px`);
      flow.style.columnWidth = `${width}px`;
      // The gap is the whole side padding, so column N+1 begins exactly at the
      // far edge of the padding box — outside the clip — rather than in the
      // margin next to the text.
      flow.style.columnGap = `${padX}px`;

      state.step = width + padX;
      // n columns span n*W + (n-1)*gap.
      const columns = Math.max(1, Math.round((flow.scrollWidth + padX) / state.step));
      state.pages = coverPages + columns;

      // Where numbering starts: the column holding the chapter's first element.
      // Measured with the flow untranslated, so rect offsets are column offsets.
      flow.style.transform = 'translateX(0)';
      const start = flow.querySelector<HTMLElement>('[data-chapter-start]');
      const flowLeft = flow.getBoundingClientRect().left;
      const startCol = start
        ? Math.round((start.getBoundingClientRect().left - flowLeft) / state.step)
        : 0;
      state.chapterStart = coverPages + Math.max(0, startCol);

      state.page = Math.min(state.page, state.pages - 1);
      render();
    }

    function render() {
      const flowPage = Math.max(0, state.page - coverPages);
      flow.style.transform = `translateX(${-flowPage * state.step}px)`;

      root.classList.toggle('is-cover', coverPages > 0 && state.page === 0);
      root.classList.toggle('is-front', state.page < state.chapterStart);

      if (prevBtn) prevBtn.disabled = state.page === 0;
      if (nextBtn) nextBtn.disabled = state.page >= state.pages - 1;
      if (pagesOut) {
        pagesOut.textContent = state.pages > 1 ? `${state.page + 1} / ${state.pages}` : '';
      }
      if (folio) {
        const n = state.page - state.chapterStart + 1;
        folio.textContent = n >= 1 ? String(n) : '';
      }
    }

    function turn(delta: number) {
      const target = Math.min(Math.max(state.page + delta, 0), state.pages - 1);
      if (target === state.page) return;
      state.page = target;
      sound.play();
      root.classList.add('is-turning');
      window.setTimeout(() => root.classList.remove('is-turning'), 320);
      render();
    }

    prevBtn?.addEventListener('click', () => turn(-1));
    nextBtn?.addEventListener('click', () => turn(1));
    for (const b of modeBtns) {
      b.addEventListener('click', () => setMode(b.dataset.mode === 'flow' ? 'flow' : 'book'));
    }
    soundBtn?.addEventListener('click', () => {
      sound.enabled = !sound.enabled;
      soundBtn.setAttribute('aria-pressed', String(sound.enabled));
      writeStore(SOUND_KEY, sound.enabled ? 'on' : 'off');
      if (sound.enabled) sound.play();
    });

    page.addEventListener('keydown', (event) => {
      if (!root.classList.contains('is-book')) return;
      const keys: Record<string, number> = { ArrowRight: 1, PageDown: 1, ArrowLeft: -1, PageUp: -1 };
      if (event.key in keys) {
        event.preventDefault();
        turn(keys[event.key]);
      } else if (event.key === 'Home') {
        event.preventDefault();
        state.page = 0;
        render();
      } else if (event.key === 'End') {
        event.preventDefault();
        state.page = state.pages - 1;
        render();
      }
    });

    // Tap the right third of the page to advance, the left third to go back —
    // the e-reader convention, and what a thumb does on a phone.
    page.addEventListener('click', (event) => {
      if (!root.classList.contains('is-book')) return;
      const rect = page.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width;
      if (x > 0.66) turn(1);
      else if (x < 0.34) turn(-1);
    });

    let startX = 0;
    let startY = 0;
    page.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    }, { passive: true });
    page.addEventListener('touchend', (e) => {
      if (!root.classList.contains('is-book')) return;
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.6) turn(dx < 0 ? 1 : -1);
    }, { passive: true });

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(paginate, 150);
    });

    root.classList.add('is-ready');
    setMode(readStore(MODE_KEY) === 'flow' ? 'flow' : 'book');
  }

  for (const el of document.querySelectorAll<HTMLElement>('[data-reader]')) {
    // Webfonts change the metrics; measure once they have settled, but never
    // leave the reader uninitialised if that promise misbehaves.
    const start = () => initReader(el);
    if (document.fonts?.ready) document.fonts.ready.then(start).catch(start);
    else start();
  }
</script>
