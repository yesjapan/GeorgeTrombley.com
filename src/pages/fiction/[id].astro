---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookReader from '../../components/BookReader.astro';
import { site, links, publisher } from '../../data/site';

export const getStaticPaths: GetStaticPaths = async () => {
  // Drafts produce no route at all, so an unfinished chapter has no URL to be
  // stumbled on or indexed.
  const excerpts = (await getCollection('fiction')).filter((e) => !e.data.draft);
  return excerpts.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
};

interface Props {
  entry: CollectionEntry<'fiction'>;
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

// Rough reading time from the raw markdown. 240 wpm is a fair pace for fiction.
const words = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 240));

const siblings = (await getCollection('fiction'))
  .filter((e) => !e.data.draft && e.data.book === d.book)
  .sort((a, b) => a.data.order - b.data.order);
const position = siblings.findIndex((e) => e.id === entry.id);
const next = position > -1 && position < siblings.length - 1 ? siblings[position + 1] : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Chapter',
  name: d.title,
  isPartOf: {
    '@type': 'Book',
    name: d.book,
    author: { '@type': 'Person', name: site.name, url: site.url },
    publisher: { '@type': 'Organization', name: publisher.fiction },
  },
  author: { '@type': 'Person', name: site.name, url: site.url },
  description: d.description,
  inLanguage: 'en',
};
---

<BaseLayout
  title={`${d.title} — ${d.book}`}
  description={d.description}
  type="article"
  jsonLd={jsonLd}
>
  <!--
    Fonts taken from the manuscript itself rather than guessed: the .docx sets
    body prose in Times New Roman 10.5pt, headings in FateSquaredR, and inherits
    Arial for the chat. Times and Arial are on effectively every device, so the
    only webfont needed is George's own display face — one 18KB file, and no
    Google Fonts request at all.
  -->
  <style slot="head" is:inline>
    @font-face {
      font-family: 'FateSquared';
      src: url('/fonts/FateSquared-Regular.woff2') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    /* The speech-bubble glyph after each sender's name (U+F13E). `block`
       rather than `swap`: a private-use codepoint has no fallback glyph, so
       swapping in would flash a tofu box before the bubble arrives. */
    @font-face {
      font-family: 'FromZeroEmoji';
      src: url('/fonts/FromZeroEMOJIHEADS-Regular.ttf') format('truetype');
      font-weight: 400;
      font-style: normal;
      font-display: block;
      unicode-range: U+F100-F13F;
    }
  </style>

  <article class="chapter">
    <header class="chapter__head">
      <a class="chapter__back" href="/fiction">&larr; {d.book}</a>
      <p class="label chapter__meta">
        {d.book} &middot; {minutes} min read
      </p>
      <h1 class="chapter__title">{d.title}</h1>
    </header>

    <BookReader label={d.title} title={d.book}>
      <div class="chapter__body">
        <Content />
      </div>
    </BookReader>

    <footer class="chapter__end">
      <hr class="rule" />
      {
        next ? (
          <a class="chapter__next" href={`/fiction/${next.id}`}>
            <span class="label">Next</span>
            <span>{next.data.title}</span>
          </a>
        ) : (
          <p class="chapter__end-note">
            That&rsquo;s the end of the sample.
          </p>
        )
      }

      <div class="chapter__cta">
        <a class="btn btn-seal" href={d.buyUrl ?? links.fateSquared} rel="noopener">
          Get {d.book}
        </a>
        <a class="btn" href="/fiction">About the novel</a>
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  /* A reading column, narrower than the rest of the site and centred — this is
     the one page people stay on for ten minutes rather than scan. */
  .chapter {
    /* The manuscript sets Heading1 in FateSquaredR; the running heads and
       chapter title follow it. */
    --reader-head-font: 'FateSquared', var(--font-body);
    width: min(100% - var(--gutter) * 2, 64rem);
    margin-inline: auto;
    padding-block: var(--space-2xl);
  }

  .chapter__back {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--ink-muted);
    text-decoration: none;
    margin-block-end: var(--space-xl);
  }

  .chapter__back:hover {
    color: var(--seal);
  }

  .chapter__title {
    font-family: 'FateSquared', var(--font-display);
    letter-spacing: 0.01em;
    font-size: var(--text-3xl);
    margin-block: var(--space-2xs) 0;
  }

  .chapter__head {
    margin-block-end: var(--space-2xl);
  }

  /* Set from the manuscript's own paragraph style, 1Text:
       Times New Roman 10.5pt, justified, 15pt exact leading, 0.25" first-line
       indent. The page is 6" wide, so 10.5pt is 2.43% of the page width; it is
       set a little larger than true size because a screen is further from the
       eye than a book, and clamped so it never gets tiny on a laptop or huge
     on a monitor. Leading and indent are ratios of the type, so they follow.

     Justification and hyphenation go together — justification alone produces
     the rivers of white that make web text look amateur beside a printed page.
     They work here precisely because the measure is the book's 4.5". */
  .chapter__body {
    font-family: 'Times New Roman', Times, Tinos, 'Liberation Serif', serif;
    font-size: clamp(14px, 2.9cqw, 19px);
    line-height: 1.43;
    color: var(--ink);
    text-align: justify;
    text-wrap: pretty;
    hyphens: auto;
    -webkit-hyphens: auto;
    orphans: 2;
    widows: 2;
  }

  .chapter__body :global(p) {
    margin-block-start: 0;
  }

  /* 0.25" at 10.5pt. The first paragraph of the chapter and the first after a
     scene break are not indented, as in the book (1Textnoindent). */
  .chapter__body :global(p + p) {
    text-indent: 1.71em;
    margin-block-start: 0;
  }

  .chapter__body :global(hr + p) {
    text-indent: 0;
  }

  /* Scene break: a centred ornament, not a rule across the column. */
  .chapter__body :global(hr) {
    border: 0;
    margin-block: 2em;
    text-align: center;
  }

  .chapter__body :global(hr::before) {
    content: '· · ·';
    letter-spacing: 0.6em;
    color: var(--ink-faint);
    font-size: var(--text-lg);
  }

  .chapter__body :global(em) {
    font-style: italic;
  }

  /* ---------- Text-message exchanges ----------
     Written in markdown as a ```chat fence; see src/lib/remark-chat.mjs.
     Set the way the book does: sender in bold sans with a bubble, the lines
     themselves in sans italic, and the point-of-view character's messages
     ranged right so the two sides of the conversation read at a glance. */
  /* From the manuscript's Chat / Chat0 styles: Arial 10pt italic, the same
     15pt leading as the prose; George (Chat) ranged right and indented 0.24"
     from the right margin, Kim (Chat0) ranged left and indented 0.5" from the
     left. Those indents are what make the two sides read as two people rather
     than as text that happens to be aligned differently. */
  .chapter__body :global(.chat) {
    --chat-dot: var(--paper-raised);
    margin-block: 1.43em;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.952em; /* 10pt / 10.5pt */
    line-height: 1.5;
  }

  /* Keep a sender's name with their messages. Without this the column break
     can strand "Kim" alone at the foot of one page and put what she said at
     the top of the next, which no typesetter would allow. */
  .chapter__body :global(.chat__turn) {
    margin-block-start: 1.1em;
    break-inside: avoid;
  }

  .chapter__body :global(.chat__turn--in) {
    text-align: left;
    margin-inline-start: 8.33cqw; /* 0.5" of a 6" page */
  }

  .chapter__body :global(.chat__turn--out) {
    text-align: right;
    margin-inline-end: 4cqw; /* 0.24" */
  }

  .chapter__body :global(.chat__who) {
    display: flex;
    align-items: center;
    gap: 0.4em;
    margin-block-end: 0.3em;
    font-weight: 700;
    font-style: normal;
    letter-spacing: 0.01em;
    color: var(--ink);
    text-indent: 0;
  }

  .chapter__body :global(.chat__turn--out .chat__who) {
    justify-content: flex-end;
  }

  /* The bubble is a glyph from George's emoji font, not an image. */
  .chapter__body :global(.chat__icon) {
    font-family: 'FromZeroEmoji';
    font-style: normal;
    font-weight: 400;
    font-size: 1.1em;
    line-height: 1;
    flex: none;
    color: var(--ink);
  }

  /* Emphasis inside a message. Italic is already the default here, so it
     cannot also mark emphasis — the book underlines, and so does this. */
  .chapter__body :global(.chat__msg u) {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .chapter__body :global(.chat__msg strong) {
    font-weight: 700;
    color: var(--ink);
  }

  /* Beats the `p + p` indent rule above — messages are never indented. */
  .chapter__body :global(.chat__msg) {
    margin: 0;
    font-style: italic;
    color: var(--ink);
    text-indent: 0;
    /* Justifying two-word messages looks broken; these range instead. */
    text-align: inherit;
    hyphens: none;
  }

  .chapter__end {
    margin-block-start: var(--space-2xl);
  }

  .chapter__end-note {
    margin-block-start: var(--space-lg);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--ink-muted);
  }

  .chapter__next {
    display: grid;
    gap: 0.2em;
    margin-block-start: var(--space-lg);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    text-decoration: none;
  }

  .chapter__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-lg);
  }
</style>
