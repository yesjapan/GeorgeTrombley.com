---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookReader from '../../components/BookReader.astro';
import { links } from '../../data/site';
import { assetSvg } from '../../lib/inline-svg';

export const getStaticPaths: GetStaticPaths = async () => {
  // Drafts produce no route at all, so an unfinished chapter has no URL to be
  // stumbled on. Front-matter entries have no route either — they are shown
  // inside the first chapter's reader.
  const excerpts = (await getCollection('fiction')).filter(
    (e) => !e.data.draft && e.data.kind === 'chapter',
  );
  return excerpts.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
};

interface Props {
  entry: CollectionEntry<'fiction'>;
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

// Rough reading time from the raw markdown. 240 wpm is a fair pace for fiction.
const words = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 240));

const chapters = (await getCollection('fiction'))
  .filter((e) => !e.data.draft && e.data.kind === 'chapter' && e.data.book === d.book)
  .sort((a, b) => a.data.order - b.data.order);
const position = chapters.findIndex((e) => e.id === entry.id);
const next =
  position > -1 && position < chapters.length - 1 ? chapters[position + 1] : undefined;

// The book's front matter — cover, title page, copyright, dedication, and any
// prefatory text — goes before the FIRST chapter only, so opening the sample
// feels like opening the book. Later chapters start on their own page.
const front =
  position === 0
    ? (await getCollection('fiction')).find(
        (e) => e.data.kind === 'front' && e.data.book === d.book && !e.data.draft,
      )
    : undefined;
const FrontContent = front ? (await render(front)).Content : null;
const f = front?.data;

// The title-page lockup is inlined rather than loaded as an <img>, so its
// paths take the page's ink colour and follow the colour scheme.
const lockup = f?.lockup
  ? assetSvg(
      f.lockup,
      [f.title, [f.subtitle?.toLowerCase(), 'by', f.author].filter(Boolean).join(' ')].join(' — '),
    )
  : undefined;
---

<!--
  noindex: the sample is for readers who arrive here, not for search engines,
  caches or AI overviews. The Seo component emits the robots meta; _headers
  adds the matching X-Robots-Tag; the sitemap filter leaves these routes out.
  Structured data is dropped for the same reason — no point describing a page
  to indexers that are asked not to index it.
-->
<BaseLayout
  title={`${d.title} — ${d.book}`}
  description={d.description}
  type="article"
  noindex
>
  <!--
    Fonts taken from the manuscript itself rather than guessed: the .docx sets
    body prose in Times New Roman 10.5pt, headings in FateSquaredR, and inherits
    Arial for the chat. Times and Arial are on effectively every device, so the
    only self-hosted webfonts are George's own faces.
  -->
  <style slot="head" is:inline>
    @font-face {
      font-family: 'FateSquared';
      src: url('/fonts/FateSquared-Regular.woff2') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'FateSquared';
      src: url('/fonts/FateSquared-Bold.woff2') format('woff2');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }
    /* The speech-bubble glyph after each sender's name (U+F13E). `block`
       rather than `swap`: a private-use codepoint has no fallback glyph, so
       swapping in would flash a tofu box before the bubble arrives. */
    @font-face {
      font-family: 'FromZeroEmoji';
      src: url('/fonts/FromZeroEMOJIHEADS-Regular.ttf') format('truetype');
      font-weight: 400;
      font-style: normal;
      font-display: block;
      unicode-range: U+F100-F13F;
    }
  </style>
  <!--
    Monochrome emoji for the faces inside messages, matching the printed book.
    Relying on the text-presentation selector alone is not enough: Windows
    honours it (Segoe UI Symbol), but Mac and iOS draw Apple Color Emoji
    regardless, so readers there would see a yellow face. Google serves Noto
    Emoji split by character range, so a chapter with one crying face fetches
    only the slice that contains it.
  -->
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Noto+Emoji&display=block"
  />

  <article class="chapter">
    <header class="chapter__head">
      <a class="chapter__back" href="/fiction">&larr; {d.book}</a>
      <p class="label chapter__meta">
        {d.book} &middot; {d.title} &middot; {minutes} min read
      </p>
    </header>

    <BookReader label={d.title} title={d.book}>
      {
        f?.cover && (
          <Image
            slot="cover"
            src={f.cover}
            alt={`Cover of ${d.book}`}
            width={720}
            widths={[480, 720, 1030]}
            sizes="(max-width: 48rem) 90vw, 42rem"
            loading="eager"
          />
        )
      }

      {
        f && (
          <div slot="front" class="front">
            <!-- Title page, as the book has it: the lockup in the upper half,
                 the copyright line on the last line of the text block. -->
            <section class="reader__fixed front__title" aria-label="Title page">
              {
                lockup ? (
                  <div class="front__lockup" set:html={lockup} />
                ) : (
                  <div class="front__lockup front__lockup--text">
                    <p class="front__title-main">{f.title}</p>
                    <p class="front__title-by">
                      {f.subtitle && <span>{f.subtitle} by</span>}
                      <span class="front__title-author">{f.author}</span>
                    </p>
                  </div>
                )
              }
              {f.copyright && <p class="front__copyright">{f.copyright}</p>}
            </section>

            {
              FrontContent && (
                <div class="chapter__body front__prose">
                  <FrontContent />
                </div>
              )
            }
          </div>
        )
      }

      <div class="chapter__body" data-chapter-start>
        <h2 class="chapter__opener">{d.heading ?? d.title}</h2>
        <Content />
      </div>
    </BookReader>

    <footer class="chapter__end">
      <hr class="rule" />
      {
        next ? (
          <a class="chapter__next" href={`/fiction/${next.id}`}>
            <span class="label">Next</span>
            <span>{next.data.title}</span>
          </a>
        ) : (
          <p class="chapter__end-note">
            That&rsquo;s the end of the sample.
          </p>
        )
      }

      <div class="chapter__cta">
        <a class="btn btn-seal" href={d.buyUrl ?? links.fateSquared} rel="noopener">
          Get {d.book}
        </a>
        <a class="btn" href="/fiction">About the novel</a>
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  .chapter {
    /* The manuscript sets Heading1 in FateSquaredR; the running heads and
       chapter openers follow it. */
    --reader-head-font: 'FateSquared', var(--font-body);
    width: min(100% - var(--gutter) * 2, 64rem);
    margin-inline: auto;
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .chapter__back {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--ink-muted);
    text-decoration: none;
    margin-block-end: var(--space-sm);
  }

  .chapter__back:hover {
    color: var(--seal);
  }

  .chapter__head {
    margin-block-end: var(--space-lg);
  }

  /* ---------- Body prose ----------
     From the manuscript's paragraph style, 1Text: Times New Roman 10.5pt,
     justified, 15pt exact leading, 0.25" first-line indent. The page is 6"
     wide, so 10.5pt is 2.43% of the page width; it is set a little larger than
     true size because a screen is further from the eye than a book, and
     clamped so it never gets tiny on a laptop or huge on a monitor. Leading and
     indent are ratios of the type, so they follow.

     Justification and hyphenation go together — justification alone produces
     the rivers of white that make web text look amateur beside a printed page.
     They work here precisely because the measure is the book's 4.5". */
  .chapter__body {
    font-family: 'Times New Roman', Times, Tinos, 'Liberation Serif', serif;
    font-size: clamp(14px, 2.9cqw, 19px);
    line-height: 1.43;
    color: var(--ink);
    text-align: justify;
    text-wrap: pretty;
    hyphens: auto;
    -webkit-hyphens: auto;
    orphans: 2;
    widows: 2;
  }

  .chapter__body :global(p) {
    margin-block-start: 0;
  }

  /* 0.25" at 10.5pt. The first paragraph of the chapter and the first after a
     scene break are not indented, as in the book (1Textnoindent). */
  .chapter__body :global(p + p) {
    text-indent: 1.71em;
    margin-block-start: 0;
  }

  .chapter__body :global(hr + p),
  .chapter__body :global(h2 + p) {
    text-indent: 0;
  }

  /* Chapter opener, from Heading1: FateSquaredR at 20pt, i.e. 1.9x the body.
     Books drop the opener some way down the page; the manuscript relies on
     spacing for this, so the distance is a judgement. */
  .chapter__opener,
  .chapter__body :global(h2) {
    font-family: 'FateSquared', var(--font-display);
    font-weight: 400;
    font-size: 1.9em;
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-align: left;
    margin-block: 14cqw 1.4em;
  }

  /* Scene break: a centred ornament, not a rule across the column. */
  .chapter__body :global(hr) {
    border: 0;
    margin-block: 2em;
    text-align: center;
  }

  .chapter__body :global(hr::before) {
    content: '· · ·';
    letter-spacing: 0.6em;
    color: var(--ink-faint);
    font-size: var(--text-lg);
  }

  .chapter__body :global(em) {
    font-style: italic;
  }

  /* ---------- Front matter ----------
     Laid out from the manuscript's own pages. The prefatory pages set their
     paragraphs as blocks with a line of space between, not with the chapter's
     first-line indent. */
  .chapter__body.front__prose {
    font-size: clamp(13px, 2.67cqw, 17.5px);
  }

  .front__prose :global(p + p) {
    text-indent: 0;
    margin-block-start: 0.7em;
  }

  /* A run-in heading on the same page ("About me – The author"): bold, in the
     text face, with its paragraph directly beneath. */
  .front__prose :global(h3) {
    font: inherit;
    font-weight: 700;
    margin-block: 1em 0;
    text-align: left;
  }

  .front__prose :global(h3 + p) {
    margin-block-start: 0;
  }

  /* A page heading (the Foreword): a fresh page, the word set top-right in
     FateSquared where a running head would go, the text starting some way
     below it. */
  .chapter__body.front__prose :global(h2) {
    break-before: column;
    font-family: 'FateSquared', var(--font-display);
    font-weight: 400;
    font-size: 1.55em;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: right;
    margin: 0 0 7cqw;
  }

  .front__prose :global(.front__dedication) {
    margin-block-start: 2em;
    padding-inline: 6%;
    text-align: center;
    text-indent: 0;
    text-wrap: balance;
  }

  /* ---------- Title page ----------
     The lockup starts about a fifth of the way down the page and spans most
     of the measure; the copyright line sits on the last line of the text
     block, at the book's true type size. */
  .front__title {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: var(--ink);
  }

  .front__lockup {
    inline-size: 88%;
    margin-block-start: 15cqw;
  }

  .front__lockup :global(svg) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .front__copyright {
    margin-block-start: auto;
    font-family: 'Times New Roman', Times, Tinos, 'Liberation Serif', serif;
    font-size: clamp(12px, 2.45cqw, 16px);
    line-height: 1.4;
    text-indent: 0;
  }

  /* Text fallback for a book without a lockup file. */
  .front__lockup--text {
    font-family: 'FateSquared', var(--font-display);
  }

  .front__title-main {
    font-weight: 700;
    font-size: 17cqw;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .front__title-by {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0 0.45em;
    margin-block-start: 5cqw;
    font-size: 3.2cqw;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .front__title-author {
    font-size: 1.55em;
    letter-spacing: 0.08em;
  }

  /* Scrolling text has no page to be proportional to; hold the lockup to a
     sensible size there. */
  :global(.reader:not(.is-book)) .front__lockup {
    max-inline-size: 20rem;
    margin-block: var(--space-lg);
  }

  :global(.reader:not(.is-book)) .front__title-main {
    font-size: clamp(2.75rem, 10cqw, 4.5rem);
  }

  :global(.reader:not(.is-book)) .front__copyright {
    margin-block-start: var(--space-md);
  }

  /* ---------- Text-message exchanges ----------
     From the manuscript's Chat / Chat0 styles: Arial 10pt italic, the same
     15pt leading as the prose; George (Chat) ranged right and indented 0.24"
     from the right margin, Kim (Chat0) ranged left and indented 0.5" from the
     left. Those indents are what make the two sides read as two people rather
     than as text that happens to be aligned differently. */
  .chapter__body :global(.chat) {
    --chat-dot: var(--paper-raised);
    margin-block: 1.43em;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.952em; /* 10pt / 10.5pt */
    line-height: 1.5;
  }

  /* Keep a sender's name with their messages. Without this the column break
     can strand "Kim" alone at the foot of one page and put what she said at
     the top of the next, which no typesetter would allow. */
  .chapter__body :global(.chat__turn) {
    margin-block-start: 1.1em;
    break-inside: avoid;
  }

  .chapter__body :global(.chat__turn--in) {
    text-align: left;
    margin-inline-start: 8.33cqw; /* 0.5" of a 6" page */
  }

  .chapter__body :global(.chat__turn--out) {
    text-align: right;
    margin-inline-end: 4cqw; /* 0.24" */
  }

  .chapter__body :global(.chat__who) {
    display: flex;
    align-items: center;
    gap: 0.4em;
    margin-block-end: 0.3em;
    font-weight: 700;
    font-style: normal;
    letter-spacing: 0.01em;
    color: var(--ink);
    text-indent: 0;
  }

  .chapter__body :global(.chat__turn--out .chat__who) {
    justify-content: flex-end;
  }

  /* Emoji in a message: upright and monochrome, as the book sets them. The
     variation selector the plugin appends does most of the work; the font
     list puts a monochrome face first so every platform matches the print. */
  .chapter__body :global(.chat__emoji) {
    font-style: normal;
    font-variant-emoji: text;
    font-family: 'Noto Emoji', 'Segoe UI Symbol', sans-serif;
  }

  /* The bubble is a glyph from George's emoji font, not an image. */
  .chapter__body :global(.chat__icon) {
    font-family: 'FromZeroEmoji';
    font-style: normal;
    font-weight: 400;
    font-size: 1.1em;
    line-height: 1;
    flex: none;
    color: var(--ink);
  }

  /* Emphasis inside a message. Italic is already the default here, so it
     cannot also mark emphasis — the book underlines, and so does this. */
  .chapter__body :global(.chat__msg u) {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .chapter__body :global(.chat__msg strong) {
    font-weight: 700;
    color: var(--ink);
  }

  /* Beats the `p + p` indent rule above — messages are never indented. */
  .chapter__body :global(.chat__msg) {
    margin: 0;
    font-style: italic;
    color: var(--ink);
    text-indent: 0;
    /* Justifying two-word messages looks broken; these range instead. */
    text-align: inherit;
    hyphens: none;
  }

  /* ---------- After the reader ---------- */
  .chapter__end {
    max-inline-size: 42rem;
    margin: var(--space-2xl) auto 0;
  }

  .chapter__end-note {
    margin-block-start: var(--space-lg);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--ink-muted);
  }

  .chapter__next {
    display: grid;
    gap: 0.2em;
    margin-block-start: var(--space-lg);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    text-decoration: none;
  }

  .chapter__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-lg);
  }
</style>
