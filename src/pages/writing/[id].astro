---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import { site } from '../../data/site';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = (await getCollection('posts')).filter((p) => !p.data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
};

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

// Chronological neighbours, newest first.
const all = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const position = all.findIndex((p) => p.id === post.id);
const newer = position > 0 ? all[position - 1] : undefined;
const older = position < all.length - 1 ? all[position + 1] : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  author: { '@type': 'Person', name: site.name, url: site.url },
  mainEntityOfPage: d.canonicalUrl ?? new URL('/writing/' + post.id, site.url).href,
  inLanguage: 'en',
};

// The link preview — Discord, Slack, iMessage, X — takes the essay's hero
// rather than the site card, so a shared essay looks like itself. Rendered
// once at build to the 1.91:1 that every network crops to anyway; without a
// hero the layout falls back to the site card.
const ogImage = d.hero
  ? await getImage({ src: d.hero, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 })
  : undefined;
---

<BaseLayout
  title={d.title}
  description={d.description}
  type="article"
  canonical={d.canonicalUrl}
  image={ogImage?.src}
  jsonLd={jsonLd}
>
  {
    /* Turnstile, for the comment form. Only when comments are switched on. */
    import.meta.env.PUBLIC_TURNSTILE_SITE_KEY && (
      <script slot="head" is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
    )
  }
  <article class="section wrap post">
    <header class="post__head">
      <a class="post__back" href="/writing">&larr; Writing</a>

      <time class="label post__date" datetime={d.date.toISOString()}>
        {dateFmt.format(d.date)}
      </time>

      <h1 class="post__title">{d.title}</h1>
      <p class="post__standfirst">{d.description}</p>

      {
        d.tags.length > 0 && (
          <ul class="post__tags" role="list">
            {d.tags.map((tag) => (
              <li class="post__tag">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      d.hero && (
        <Image
          src={d.hero}
          alt=""
          width={1280}
          widths={[640, 960, 1280]}
          sizes="(max-width: 48rem) 92vw, 44rem"
          class="post__hero"
        />
      )
    }

    <div class="prose post__body">
      <Content />
    </div>

    {
      d.sourceUrl && (
        <p class="post__origin">
          Also published on{' '}
          <a href={d.sourceUrl} rel="noopener">
            {d.originallyPublishedAt ?? 'another site'}
          </a>
          .
        </p>
      )
    }

    {
      (newer || older) && (
        <nav class="post__nav" aria-label="More essays">
          <hr class="rule" />
          <div class="post__nav-row">
            {older ? (
              <a class="post__nav-link" href={'/writing/' + older.id}>
                <span class="label">Older</span>
                <span>{older.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {newer && (
              <a
                class="post__nav-link post__nav-link--next"
                href={'/writing/' + newer.id}
              >
                <span class="label">Newer</span>
                <span>{newer.data.title}</span>
              </a>
            )}
          </div>
        </nav>
      )
    }

    <Comments post={post.id} />
  </article>
</BaseLayout>

<style>
  .post {
    max-inline-size: min(100% - var(--gutter) * 2, 46rem);
  }

  .post__back {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--ink-muted);
    text-decoration: none;
    margin-block-end: var(--space-lg);
  }

  .post__back:hover {
    color: var(--seal);
  }

  .post__title {
    font-size: var(--text-3xl);
    margin-block: var(--space-2xs) var(--space-md);
  }

  .post__standfirst {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    color: var(--ink-muted);
    max-inline-size: 34ch;
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-md);
  }

  .post__tag {
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--ink-faint);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.25em 0.75em;
  }

  .post__hero {
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow-cover);
    margin-block: var(--space-xl) 0;
  }

  .post__head {
    padding-block-end: var(--space-lg);
    border-block-end: 1px solid var(--rule);
  }

  .post__body {
    margin-block-start: var(--space-xl);
    /* The article column is already narrow; let prose fill it. */
    max-inline-size: none;
  }

  /* A gallery: several images written on consecutive lines of one Markdown
     paragraph (no blank line between them) lay out as a grid instead of a
     tall stack — a set of book covers, say. Linked images count too. */
  .post__body :global(p:has(> img + img)),
  .post__body :global(p:has(> a + a > img)) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--space-xs);
    align-items: start;
  }

  .post__body :global(p:has(> img + img) img),
  .post__body :global(p:has(> a + a > img) img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    margin: 0;
  }

  .post__origin {
    margin-block-start: var(--space-xl);
    font-size: var(--text-sm);
    color: var(--ink-faint);
  }

  .post__nav {
    margin-block-start: var(--space-2xl);
  }

  .post__nav-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block-start: var(--space-md);
  }

  .post__nav-link {
    display: grid;
    gap: 0.2em;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    max-inline-size: 18ch;
  }

  .post__nav-link--next {
    text-align: end;
    justify-items: end;
  }
</style>
